# URL pública del sitio (sin barra final). En Vercel usar el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — el proyecto expone la URL y la anon key en el navegador (seguras).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SOLO servidor. Nunca exponer al navegador ni versionar.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envío de correos.
RESEND_API_KEY=

# Correo donde la propietaria de Peach Estudio recibe las solicitudes.
BOOKING_NOTIFICATION_EMAIL=

# Remitente verificado en Resend (ej. "Peach Estudio <hola@tudominio.com>").
EMAIL_FROM=
